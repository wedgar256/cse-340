<%- include('partials/header') %>
<h2>Projects</h2>
<ul class="project-list">
  <% projects.forEach((project) => { %>
    <li>
      <strong><a href="/projects/<%= project.project_id %>"><%= project.name %></a>:</strong>
      <%= project.description %>
      <% if (project.organization_name) { %>
        <span> - <%= project.organization_name %></span>
      <% } %>
    </li>
  <% }); %>
</ul>
<%- include('partials/footer') %>
