<%- include('partials/header') %>
<h2>Organizations</h2>
<p><a href="/organizations/create">Create Organization</a></p>
<div class="org-grid">
  <% organizations.forEach((org) => { %>
    <div class="org-card">
      <% if (org.logo_url) { %>
        <img src="<%= org.logo_url %>" alt="<%= org.name %> Logo">
      <% } %>
      <h3><a href="/organizations/<%= org.organization_id %>"><%= org.name %></a></h3>
      <p><%= org.description %></p>
    </div>
  <% }); %>
</div>
<%- include('partials/footer') %>
