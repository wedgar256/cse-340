<%- include('partials/header') %>
<h2><%= title %></h2>
<% const fieldError = (field) => errors.find((error) => error.field === field); %>
<% if (errors.length > 0) { %>
  <div class="form-errors" role="alert">
    <strong>Please fix the following:</strong>
    <ul>
      <% errors.forEach((error) => { %>
        <li><%= error.message %></li>
      <% }); %>
    </ul>
  </div>
<% } %>
<form action="<%= action %>" method="post" class="entity-form">
  <div class="form-field">
    <label for="name">Name *</label>
    <input
      type="text"
      id="name"
      name="name"
      value="<%= organization.name || '' %>"
      maxlength="100"
      required
    >
    <% if (fieldError('name')) { %>
      <p class="field-error"><%= fieldError('name').message %></p>
    <% } %>
  </div>
  <div class="form-field">
    <label for="description">Description *</label>
    <textarea
      id="description"
      name="description"
      rows="5"
      required
    ><%= organization.description || '' %></textarea>
    <% if (fieldError('description')) { %>
      <p class="field-error"><%= fieldError('description').message %></p>
    <% } %>
  </div>
  <div class="form-field">
    <label for="logo_url">Logo URL</label>
    <input
      type="text"
      id="logo_url"
      name="logo_url"
      value="<%= organization.logo_url || '' %>"
      placeholder="/images/org1.svg or https://example.com/logo.png"
      pattern="^(https?:\/\/|\/).*$"
    >
    <% if (fieldError('logo_url')) { %>
      <p class="field-error"><%= fieldError('logo_url').message %></p>
    <% } %>
  </div>
  <div class="form-actions">
    <button type="submit"><%= organization.organization_id ? 'Save Changes' : 'Create Organization' %></button>
    <a href="<%= organization.organization_id ? '/organizations/' + organization.organization_id : '/organizations' %>" class="btn-secondary">Cancel</a>
  </div>
</form>
<%- include('partials/footer') %>
