<%- include('partials/header') %>
<h2><%= title %></h2>
<% const fieldError = (field) => errors.find((error) => error.field === field); %>
<% if (errors.length > 0) { %>
  <div class="form-errors" role="alert">
    <strong>Please fix the following:</strong>
    <ul>
      <% errors.forEach((error) => { %>
        <li><%= error.message %></li>
      <% }); %>
    </ul>
  </div>
<% } %>
<form action="<%= action %>" method="post" class="entity-form">
  <div class="form-field">
    <label for="name">Name *</label>
    <input
      type="text"
      id="name"
      name="name"
      value="<%= category.name || '' %>"
      maxlength="100"
      required
    >
    <% if (fieldError('name')) { %>
      <p class="field-error"><%= fieldError('name').message %></p>
    <% } %>
  </div>
  <div class="form-actions">
    <button type="submit"><%= category.category_id ? 'Save Changes' : 'Create Category' %></button>
    <a href="<%= category.category_id ? '/categories/' + category.category_id : '/categories' %>" class="btn-secondary">Cancel</a>
  </div>
</form>
<%- include('partials/footer') %>
