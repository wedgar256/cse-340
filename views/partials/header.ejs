<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | CSE 340 Portal</title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
  <header>
    <div class="logo">CSE 340 Application</div>
    <nav>
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/organizations">Organizations</a></li>
        <li><a href="/projects">Projects</a></li>
        <li><a href="/categories">Categories</a></li>
      </ul>
    </nav>
  </header>
  <main>
    <% if (locals.successMessages && successMessages.length > 0) { %>
      <div class="flash-messages">
        <% successMessages.forEach((message) => { %>
          <p class="flash flash-success"><%= message %></p>
        <% }); %>
      </div>
    <% } %>
    <% if (locals.errorMessages && errorMessages.length > 0) { %>
      <div class="flash-messages">
        <% errorMessages.forEach((message) => { %>
          <p class="flash flash-error"><%= message %></p>
        <% }); %>
      </div>
    <% } %>
