<%- include('partials/header') %>
<h2><%= title %></h2>
<% if (errors.length > 0) { %>
  <div class="form-errors" role="alert">
    <strong>Please fix the following:</strong>
    <ul>
      <% errors.forEach((error) => { %>
        <li><%= error.message %></li>
      <% }); %>
    </ul>
  </div>
<% } %>
<p>Select the categories that apply to <strong><%= project.name %></strong>.</p>
<form action="/projects/<%= project.project_id %>/assign-categories" method="post" class="entity-form">
  <fieldset class="checkbox-group">
    <legend>Categories</legend>
    <% categories.forEach((category) => { %>
      <label class="checkbox-label">
        <input
          type="checkbox"
          name="category_ids"
          value="<%= category.category_id %>"
          <%= assignedCategoryIds.includes(category.category_id) ? 'checked' : '' %>
        >
        <%= category.name %>
      </label>
    <% }); %>
  </fieldset>
  <% if (errors.length > 0) { %>
    <p class="field-error">Select valid categories before saving.</p>
  <% } %>
  <div class="form-actions">
    <button type="submit">Save Categories</button>
    <a href="/projects/<%= project.project_id %>" class="btn-secondary">Cancel</a>
  </div>
</form>
<%- include('partials/footer') %>
