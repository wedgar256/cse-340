<%- include('partials/header') %>
<h2><%= category.name %></h2>
<h3>Projects</h3>
<ul class="project-list">
  <% projects.forEach((project) => { %>
    <li>
      <a href="/projects/<%= project.project_id %>"><%= project.name %></a>
      <% if (project.location) { %> - <%= project.location %><% } %>
      <% if (project.date) { %> (<%= project.date %>)<% } %>
    </li>
  <% }); %>
</ul>
<p><a href="/categories/<%= category.category_id %>/edit">Edit Category</a> | <a href="/categories">Back to categories</a></p>
<%- include('partials/footer') %>
