<%- include('partials/header') %>
<h2><%= project.name %></h2>
<p><%= project.description %></p>
<% if (project.location) { %>
  <p>Location: <%= project.location %></p>
<% } %>
<% if (project.date) { %>
  <p>Date: <%= project.date %></p>
<% } %>
<% if (project.organization_name) { %>
  <p>Organization: <%= project.organization_name %></p>
<% } %>
<h3>Categories</h3>
<ul class="category-list">
  <% categories.forEach((category) => { %>
    <li><a href="/categories/<%= category.category_id %>"><%= category.name %></a></li>
  <% }); %>
</ul>
<p class="detail-actions">
  <a href="/projects/<%= project.project_id %>/edit">Edit Project</a> |
  <a href="/projects/<%= project.project_id %>/assign-categories">Assign Categories</a> |
  <a href="/projects">Back to projects</a>
</p>
<%- include('partials/footer') %>
