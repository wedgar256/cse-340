<%- include('partials/header') %>
<main>
  <h1><%= title %></h1>
  <form class="form-card" action="/login" method="POST">
    <% if (errors && errors.length) { %>
      <div class="validation-summary" role="alert" aria-labelledby="login-errors-title">
        <h2 id="login-errors-title">Please check your details</h2>
        <ul><% errors.forEach(error => { %><li><%= error.msg %></li><% }); %></ul>
      </div>
    <% } %>
    <div class="form-group">
      <label for="email">Email</label>
      <input type="email" id="email" name="email" value="<%= formData.email || '' %>" maxlength="100" autocomplete="username" required>
    </div>
    <div class="form-group">
      <label for="password">Password</label>
      <input type="password" id="password" name="password" autocomplete="current-password" required>
    </div>
    <button type="submit">Log in</button>
  </form>
</main>
<%- include('partials/footer') %>
