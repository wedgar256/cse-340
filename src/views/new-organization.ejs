<%- include('partials/header') %>
<main>
  <h1><%= title %></h1>

  <form class="form-card" action="/new-organization" method="POST">
    <% if (errors && errors.length) { %>
      <div class="validation-summary" role="alert" aria-labelledby="new-organization-errors-title">
        <h2 id="new-organization-errors-title">Please fix these issues</h2>
        <ul><% errors.forEach(error => { %><li><%= error.msg %></li><% }); %></ul>
      </div>
    <% } %>
    <div class="form-group">
      <label for="name">Organization Name</label>
      <input type="text" id="name" name="name" value="<%= formData.name || '' %>" minlength="3" maxlength="150" required>
    </div>

    <div class="form-group">
      <label for="description">Description</label>
      <textarea id="description" name="description" maxlength="500" required><%= formData.description || '' %></textarea>
    </div>

    <div class="form-group">
      <label for="contactEmail">Contact Email</label>
      <input type="email" id="contactEmail" name="contactEmail" value="<%= formData.contactEmail || '' %>" maxlength="255" required>
    </div>

    <button type="submit">Create Organization</button>
  </form>
</main>
<%- include('partials/footer') %>
