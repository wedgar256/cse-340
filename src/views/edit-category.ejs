<%- include('partials/header') %>
<main>
  <h1><%= title %></h1>

  <form class="form-card" action="/edit-category/<%= categoryDetails.category_id %>" method="POST">
    <div class="form-group">
      <label for="name">Category Name</label>
      <input
        type="text"
        id="name"
        name="name"
        value="<%= categoryDetails.name %>"
        maxlength="100"
        required
      >
    </div>

    <div class="card-actions">
      <button type="submit">Update Category</button>
      <a class="button button-quiet" href="/categories">Cancel</a>
    </div>
  </form>
</main>
<%- include('partials/footer') %>
