<%- include('../partials/header') %>
<main class="error-page error-500">
  <div class="error-code" aria-hidden="true">500</div>
  <section class="error-card">
    <p class="eyebrow">A temporary setback</p>
    <h1>Something went wrong</h1>
    <p>We couldn’t complete your request. Please try again in a moment.</p>
    <a class="button button-primary" href="/">Back to home</a>

    <% if (NODE_ENV === 'development') { %>
      <details class="error-details" open>
        <summary>Error details (development only)</summary>
        <pre><%= error %></pre>
        <pre><%= stack %></pre>
      </details>
    <% } %>
  </section>
</main>
<%- include('../partials/footer') %>
