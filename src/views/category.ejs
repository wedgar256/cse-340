<%- include('partials/header') %>
<main>
  <p class="eyebrow">Service category</p>
  <h1><%= categoryDetails.name %></h1>
  <div class="card-actions">
    <a class="button button-quiet" href="/categories">All categories</a>
    <% if (user && user.role_name === 'admin') { %>
      <a class="button button-primary" href="/edit-category/<%= categoryDetails.category_id %>">Edit category</a>
    <% } %>
  </div>

  <section class="related-section" aria-labelledby="category-projects-heading">
    <div class="section-heading">
      <h2 id="category-projects-heading">Projects in this category</h2>
      <span class="result-count"><%= projects.length %> projects</span>
    </div>
    <% if (projects.length) { %>
      <ul class="card-grid project-grid">
        <% projects.forEach(project => { %>
          <li class="data-card project-card">
            <div class="card-content">
              <h3><a href="/project/<%= project.project_id %>"><%= project.title %></a></h3>
              <p><%= project.description %></p>
              <div class="project-meta">
                <span><strong>Location</strong><%= project.location %></span>
                <span><strong>Date</strong><%= project.date %></span>
              </div>
            </div>
          </li>
        <% }); %>
      </ul>
    <% } else { %>
      <p class="empty-state">No projects are assigned to this category yet.</p>
    <% } %>
  </section>
</main>
<%- include('partials/footer') %>
