<%- include('partials/header') %>
<main>
  <p class="eyebrow">Service opportunity</p>
  <h1><%= projectDetails.title %></h1>
  <section class="form-card">
    <h2>Assign categories</h2>
    <p>Choose the areas that best describe this project.</p>

    <form action="/assign-categories/<%= projectId %>" method="POST">
      <div class="card-grid category-choice-grid">
      <% categories.forEach(category => { %>
        <label class="data-card category-choice-card" for="category-<%= category.category_id %>">
          <input
            type="checkbox"
            id="category-<%= category.category_id %>"
            name="categoryIds"
            value="<%= category.category_id %>"
            <%= assignedCategories.some(assigned => assigned.category_id === category.category_id) ? 'checked' : '' %>
          >
          <span><%= category.name %></span>
        </label>
      <% }); %>
      </div>

      <div class="card-actions">
        <button type="submit">Save categories</button>
        <a class="button button-quiet" href="/project/<%= projectId %>">Cancel</a>
      </div>
    </form>
  </section>
</main>
<%- include('partials/footer') %>
