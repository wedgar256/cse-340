<%- include('partials/header') %>
<main>
  <h1><%= title %></h1>

  <form class="form-card" action="/edit-project/<%= projectDetails.project_id %>" method="POST">
    <% if (errors && errors.length) { %>
      <div class="validation-summary" role="alert" aria-labelledby="edit-project-errors-title">
        <h2 id="edit-project-errors-title">Please fix these issues</h2>
        <ul><% errors.forEach(error => { %><li><%= error.msg %></li><% }); %></ul>
      </div>
    <% } %>
    <div class="form-group">
      <label for="title">Project Title</label>
      <input
        type="text"
        id="title"
        name="title"
        value="<%= formData.title !== undefined ? formData.title : projectDetails.title %>"
        minlength="3"
        maxlength="150"
        required
      >
    </div>

    <div class="form-group">
      <label for="description">Description</label>
    <textarea id="description" name="description" maxlength="999" required><%= formData.description !== undefined ? formData.description : projectDetails.description %></textarea>
    </div>

    <div class="form-group">
      <label for="location">Location</label>
      <input
        type="text"
        id="location"
        name="location"
        value="<%= formData.location !== undefined ? formData.location : projectDetails.location %>"
        maxlength="150"
        required
      >
    </div>

    <div class="form-group">
      <label for="date">Date</label>
    <input type="date" id="date" name="date" value="<%= formData.date !== undefined ? formData.date : projectDate %>" required>
    </div>

    <div class="form-group">
      <label for="organizationId">Organization</label>
      <select id="organizationId" name="organizationId" required>
        <option value="">Select an organization</option>
        <% organizations.forEach(organization => { %>
          <option
            value="<%= organization.organization_id %>"
            <%= String(formData.organizationId !== undefined ? formData.organizationId : projectDetails.organization_id) === String(organization.organization_id) ? 'selected' : '' %>
          ><%= organization.name %></option>
        <% }); %>
      </select>
    </div>

    <div class="card-actions">
      <button type="submit">Update Project</button>
      <a class="button button-quiet" href="/project/<%= projectDetails.project_id %>">Cancel</a>
    </div>
  </form>
</main>
<%- include('partials/footer') %>
